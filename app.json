{
  "expo": {
    "name": "CoachZeno",
    "slug": "coachgenie",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coachgenie",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.coachgenie.app",
      "buildNumber": "10"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-removebg.png",
        "backgroundColor": "#F5EDE0"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.coachgenie.app",
      "versionCode": 10,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "coachgenie",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "coachgenie",
              "host": "integrations",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-audio",
      "expo-notifications",
      "expo-asset",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DailyFocusWidget",
              "label": "Daily Focus",
              "description": "Your top priority, ritual progress, and streak count",
              "minWidth": "180dp",
              "minHeight": "180dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "QuickCoachWidget",
              "label": "Quick Coach",
              "description": "Coaching nudge with quick action buttons",
              "minWidth": "320dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 3600000
            },
            {
              "name": "ReflectionWidget",
              "label": "Reflection",
              "description": "Morning intentions and evening reflections with stats",
              "minWidth": "320dp",
              "minHeight": "320dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "updatePeriodMillis": 3600000
            },
            {
              "name": "RitualChecklistWidget",
              "label": "Ritual Checklist",
              "description": "Track your daily rituals with an interactive checklist",
              "minWidth": "320dp",
              "minHeight": "240dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TodayPlanWidget",
              "label": "Today's Plan",
              "description": "Your daily priorities and focus time at a glance",
              "minWidth": "320dp",
              "minHeight": "320dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "WeeklyProgressWidget",
              "label": "Weekly Progress",
              "description": "Your weekly coaching progress and streak",
              "minWidth": "180dp",
              "minHeight": "180dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 3600000
            },
            {
              "name": "QuoteWidget",
              "label": "Quote of the Day",
              "description": "Daily inspiration from your coaching breakthroughs",
              "minWidth": "320dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 3600000
            },
            {
              "name": "ActiveCoachWidget",
              "label": "Active Coach",
              "description": "Quick access to your active coaching session",
              "minWidth": "240dp",
              "minHeight": "180dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 3600000
            },
            {
              "name": "CreditBalanceWidget",
              "label": "Credits",
              "description": "Your AI credit balance and subscription tier",
              "minWidth": "180dp",
              "minHeight": "80dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": ""
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "15b70504-d28c-41bf-b89b-5ab8937f4050"
      }
    }
  }
}
